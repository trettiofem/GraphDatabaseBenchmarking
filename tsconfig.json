{
  // Type-check only: Node runs the .ts files directly by stripping types.
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["bench"]
}
