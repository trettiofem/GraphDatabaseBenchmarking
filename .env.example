# Copy to .env and change the passwords. Neo4j requires >= 8 characters.
# One block per engine: <NAME>_URI / _USER / _PASSWORD, where NAME is the engine's registry key in upper case.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=change-me-memgraph

# ---- Benchmark settings (bench/config.ts). Defaults shown; uncomment to change. ----
# Values set inline in the shell win over this file:  BENCH_SOAK_MINUTES=5 pnpm bench soak --db memgraph
# Quick functional check: BENCH_SOAK_MINUTES=3 BENCH_SOAK_RATE=50 BENCH_STRESS_STEP_SEC=5 BENCH_WARMUP_SEC=2 BENCH_REPEATS=1

# Engines being compared (validate compares all, soak and capacity share a target across them)
# BENCH_ENGINES=neo4j,memgraph

# Data
# BENCH_SEED=42                 # generator and query-parameter RNG
# BENCH_SCALE_M=200             # tier M = dataset.cypher shape x 200 (~100k nodes)
# BENCH_SCALE_L=4000            # tier L = x 4000 (~2M nodes); must be the same for every engine
# BENCH_BATCH_SIZE=10000        # UNWIND rows per load batch
# BENCH_MEM_HEADROOM=0.6        # tier L may use at most this share of an in-memory engine's memory
# BENCH_SKIP_LOAD=1             # reuse already-loaded data instead of reloading (iteration only)

# Timing
# BENCH_WARMUP_SEC=30           # discarded warm-up per step
# BENCH_BASELINE_ITERS=1000     # iterations per query in baseline (and coldstart)
# BENCH_REPEATS=3               # repeats per stress step (median reported) and per algorithm
# BENCH_SAMPLE_SEC=10           # metrics window / docker stats interval

# Stress
# BENCH_STRESS_STEP_SEC=60      # length of each concurrency step
# BENCH_CONCURRENCY=1,2,4,8,16,32,64,128,256
# BENCH_HEAVY_CONCURRENCY=8,32  # clients for the heavy-query steps (R4, R7, R8, R9)
# BENCH_STOP_ERROR_PCT=1        # stop a ramp above this error rate...
# BENCH_STOP_P99_MS=1000        # ...or above this p99
# BENCH_SPIKE=0.25,1.5,60       # low and high load as fractions of the read-heavy knee, high phase seconds

# Soak
# BENCH_SOAK_MINUTES=240
# BENCH_SOAK_RATE=0.6           # <= 1: fraction of the lower soak-mix knee from stress; > 1: absolute ops/s
# BENCH_SOAK_MIX=80,15,5        # % reads, W1 creates, W3 updates (W4 deletes match W1)
# BENCH_DRIFT_PCT=20            # flag p99 drift above this (first vs last hour)
# BENCH_MEM_SETTLE_MIN=30       # ignore memory growth before this

# Client and server limits
# BENCH_QUERY_TIMEOUT_SEC=60    # per query. Also read by docker compose for Memgraph's server-side timeout,
#                               # so set it here (not inline) and recreate memgraph after changing it.
# BENCH_MAX_RETRIES=10          # retries of transient errors (write conflicts, deadlocks); never timeouts
# BENCH_MAX_IN_FLIGHT=5000      # open-loop requests in flight before the client sheds load (counted as errors)
# BENCH_CAPACITY_X=2            # disk-based engines' capacity runs go to this multiple of the in-memory engines' max

# Durability parity: 1 = Memgraph fsyncs the WAL on every commit, like Neo4j. Recreate memgraph after changing.
# MG_WAL_FLUSH_EVERY_N_TX=100000
